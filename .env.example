# ==============================================================================
# Requirements Harness System Configuration (OpenRouter + Google Sheets)
# ==============================================================================

# LLM Provider
LLM_PROVIDER=openrouter

# OpenRouter API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Specialized Model Routing
# Extraction (Fast JSON parsing): google/gemini-2.5-flash
LLM_MODEL_EXTRACT=google/gemini-2.5-flash

# Semantic checks & Question Engine: deepseek/deepseek-v4-flash
LLM_MODEL_SEMANTIC=deepseek/deepseek-v4-flash

# Project Auto-Detection: deepseek/deepseek-v4-flash
LLM_MODEL_DETECT=deepseek/deepseek-v4-flash

# Google Sheets Persistence (Service Account)
# Path to downloaded Google Cloud service account JSON key
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json

# (Optional) ID of Master Projects Registry Google Sheet
HARNESS_MASTER_SHEET_ID=

# (Optional) ID of Google Drive folder shared with team where project sheets are saved
HARNESS_DRIVE_FOLDER_ID=

# Local storage fallback directory
LOCAL_STORAGE_DIR=data/projects

LLM_TEMPERATURE=0.0
