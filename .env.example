# ==============================================================================
# Requirements Harness System Environment Configuration (OpenRouter)
# ==============================================================================

# LLM Provider (openrouter | openai | anthropic | gemini)
LLM_PROVIDER=openrouter

# OpenRouter API Key (Get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenRouter Model Selection
# Popular models on OpenRouter:
# - anthropic/claude-3.5-sonnet
# - openai/gpt-4o
# - google/gemini-2.5-flash
# - deepseek/deepseek-r1
LLM_MODEL=anthropic/claude-3.5-sonnet

# Base URL for OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Extraction Temperature (0.0 for deterministic JSON extraction, 0.2 for synthesis)
LLM_TEMPERATURE=0.0

# Optional OpenRouter Ranking / App Headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Harness Requirements System
